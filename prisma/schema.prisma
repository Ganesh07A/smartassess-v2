generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(uuid())
  name            String?
  email           String?              @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  role            Role                 @default(STUDENT)
  prn             String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  accounts        Account[]
  managedBatches  Batch[]              @relation("TeacherBatches")
  sessions        Session[]
  examSessions    StudentExamSession[]
  enrolledBatches Batch[]              @relation("StudentBatches")
  certificates    Certificate[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Batch {
  id        String   @id @default(uuid())
  name      String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   User     @relation("TeacherBatches", fields: [teacherId], references: [id])
  exams     Exam[]
  students  User[]   @relation("StudentBatches")
}

model Exam {
  id           String               @id @default(uuid())
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  duration     Int
  batchId      String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  allowRunCode Boolean              @default(true)
  shuffleOptions Boolean            @default(true)
  batch        Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questions    ExamQuestion[]
  sessions     StudentExamSession[]
  certificates Certificate[]
}

model Question {
  id            String         @id @default(uuid())
  type          QuestionType
  content       String
  options       Json?
  correctAnswer String?
  testCases     Json?
  points        Float          @default(1.0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  exams         ExamQuestion[]
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  questionId String
  points     Float    @default(1.0)
  order      Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
}

model StudentExamSession {
  id             String        @id @default(uuid())
  studentId      String
  examId         String
  status         SessionStatus @default(NOT_STARTED)
  startTime      DateTime?
  endTime        DateTime?
  questionsOrder String[]
  optionsMapping Json?
  currentTimer   Int?
  tabSwitches    Int           @default(0)
  isBlurred      Boolean       @default(false)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  exam           Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissions    Submission[]

  @@unique([studentId, examId])
}

model Submission {
  id            String             @id @default(uuid())
  sessionId     String
  questionId    String
  isCorrect     Boolean?
  pointsAwarded Float?
  submittedAt   DateTime           @default(now())
  codeAnswer    String?
  mcqAnswer     String?
  language      String?
  session       StudentExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

enum Role {
  TEACHER
  STUDENT
}

enum QuestionType {
  MCQ
  CODING
}

enum SessionStatus {
  NOT_STARTED
  STARTED
  PAUSED
  COMPLETED
  FORCE_SUBMITTED
}

model Certificate {
  id               String   @id @default(uuid())
  certificateId    String   @unique // Example: SA-2026-0001
  studentId        String
  examId           String
  issueDate        DateTime @default(now())
  certificateUrl   String?
  verificationCode String?  @unique
  grade            String?
  score            Float?
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([studentId, examId])
}
