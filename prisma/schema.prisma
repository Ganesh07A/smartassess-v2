generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(uuid())
  name            String?
  email           String?              @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  role            Role                 @default(STUDENT)
  prn             String?              @unique
  department      String?
  year            String?
  division        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  accounts        Account[]
  managedBatches  Batch[]              @relation("TeacherBatches")
  sessions        Session[]
  examSessions    StudentExamSession[]
  enrolledBatches Batch[]              @relation("StudentBatches")
  certificates    Certificate[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Batch {
  id         String   @id @default(uuid())
  name       String
  teacherId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teacher    User?    @relation("TeacherBatches", fields: [teacherId], references: [id])
  exams      Exam[]
  students   User[]   @relation("StudentBatches")
  department String?

  @@index([teacherId])
  @@index([department])
  @@index([createdAt])
}

model Exam {
  id                String               @id @default(uuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  duration          Int
  batchId           String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  allowRunCode      Boolean              @default(true)
  shuffleOptions    Boolean              @default(true)
  published         Boolean              @default(false)
  // Filtering & lifecycle foundations
  status            ExamStatus           @default(DRAFT)
  examCode          String?              @unique
  resultsReleasedAt DateTime?
  answerReveal      AnswerRevealPolicy   @default(AFTER_EXAM_END)
  proctoring        Json                 @default("{}")
  negativeMarking   Float                @default(0)
  subjects          String[]             @default([])
  batch             Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questions         ExamQuestion[]
  sessions          StudentExamSession[]
  certificates      Certificate[]

  @@index([batchId, startTime])
  @@index([published, startTime])
  @@index([status])
  @@index([endTime])
}

model Question {
  id            String         @id @default(uuid())
  type          QuestionType
  content       String
  options       Json?
  correctAnswer String?
  testCases     Json?
  points        Float          @default(1.0)
  // Question-bank metadata (used by filters, analytics and paper generation)
  difficulty    Difficulty     @default(MEDIUM)
  topic         String?
  tags          String[]       @default([])
  bloomLevel    String?
  explanation   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  exams         ExamQuestion[]

  @@index([difficulty, topic])
  @@index([type, difficulty])
  @@index([tags])
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  questionId String
  points     Float    @default(1.0)
  order      Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId, order])
}

model StudentExamSession {
  id              String        @id @default(uuid())
  studentId       String
  examId          String
  status          SessionStatus @default(NOT_STARTED)
  startTime       DateTime?
  endTime         DateTime?
  questionsOrder  String[]
  optionsMapping  Json?
  currentTimer    Int?
  tabSwitches     Int           @default(0)
  isBlurred       Boolean       @default(false)
  ipAddress       String?
  userAgent       String?
  // Denormalized scoring + proctoring columns so lists can be filtered/sorted in SQL
  totalScore      Float         @default(0)
  maxScore        Float         @default(0)
  percentage      Float         @default(0)
  violationCount  Int           @default(0)
  riskScore       Int           @default(0)
  lastHeartbeatAt DateTime?
  submittedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  exam            Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissions     Submission[]
  events          ProctorEvent[]

  @@unique([studentId, examId])
  @@index([examId, percentage])
  @@index([examId, violationCount])
  @@index([examId, status])
  @@index([examId, lastHeartbeatAt])
  @@index([examId, updatedAt])
}

model Submission {
  id            String             @id @default(uuid())
  sessionId     String
  questionId    String
  isCorrect     Boolean?
  pointsAwarded Float?
  submittedAt   DateTime           @default(now())
  codeAnswer    String?
  mcqAnswer     String?
  language      String?
  session       StudentExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId])
  @@index([submittedAt])
}

/** Immutable proctoring audit trail (one row per violation / lifecycle event). */
model ProctorEvent {
  id         String             @id @default(uuid())
  sessionId  String
  type       ProctorEventType
  severity   Int                @default(1)
  metadata   Json?
  occurredAt DateTime           @default(now())
  session    StudentExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([type, occurredAt])
  @@index([severity, occurredAt])
}

/** Fixed-window rate limiter that works across serverless instances without extra infra. */
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

enum Role {
  TEACHER
  STUDENT
}

enum QuestionType {
  MCQ
  CODING
}

enum SessionStatus {
  NOT_STARTED
  STARTED
  PAUSED
  COMPLETED
  FORCE_SUBMITTED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  UPCOMING
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum AnswerRevealPolicy {
  NEVER
  AFTER_EXAM_END
  AFTER_RELEASE
  IMMEDIATELY
}

enum ProctorEventType {
  EXAM_STARTED
  EXAM_SUBMITTED
  FORCE_SUBMITTED
  TAB_BLUR
  FULLSCREEN_EXIT
  CLIPBOARD_ATTEMPT
  DEVTOOLS_ATTEMPT
  HEARTBEAT_MISSED
  DUPLICATE_TAB
  IP_COLLISION
  TIME_EXTENDED
  TEACHER_MESSAGE
}

model Certificate {
  id               String   @id @default(uuid())
  certificateId    String   @unique // Example: SA-2026-0001
  studentId        String
  examId           String
  issueDate        DateTime @default(now())
  certificateUrl   String?
  verificationCode String?  @unique
  grade            String?
  score            Float?
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([studentId, examId])
  @@index([examId])
  @@index([issueDate])
}
